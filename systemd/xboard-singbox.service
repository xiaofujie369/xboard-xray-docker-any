[Unit]
Description=XBoard sing-box synchronization and accounting
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/singbox-sync
ExecStart=/opt/singbox-sync/venv/bin/python /opt/singbox-sync/agent.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
